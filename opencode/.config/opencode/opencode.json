{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OPENCODE_MODEL:-openrouter/glm-4.6}",
  "small_model": "openrouter/glm-4.5-air",
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },
  "theme": "opencode",
  "autoupdate": true,
  "share": "manual",
  "permission": {
    "write": "ask",
    "bash": "ask",
    "edit": "ask"
  },
  "tools": {
    "read": true,
    "write": true,
    "edit": true,
    "bash": true,
    "glob": true,
    "grep": true,
    "list": true,
    "webfetch": true
  },
  "instructions": [
    "CONTRIBUTING.md",
    "README.md",
    "*.md"
  ],

  "formatter": {
    "terraform": {
      "command": ["terraform", "fmt", "-"],
      "extensions": [".tf", ".tfvars"]
    },
    "prettier": {
      "command": ["npx", "prettier", "--write", "$FILE"],
      "extensions": [".yaml", ".yml", ".json", ".md"]
    },
    "python": {
      "command": ["black", "-"],
      "extensions": [".py"]
    }
  },
  "disabled_providers": [],
  "tui": {
    "scroll_speed": 3
  },
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "environment": {
        "DEFAULT_MINIMUM_TOKENS": ""
      }
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/sse",
      "enabled": false
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_TOOLSETS": "",
        "GITHUB_READ_ONLY": "",
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "enabled": false
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "web-search": {
      "type": "remote",
      "url": "http://localhost:3002/mcp"
    }
  }
}
