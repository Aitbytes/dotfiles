{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OPENCODE_MODEL:-openrouter/glm-4.6}",
  "small_model": "openrouter/glm-4.5-air",
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },
  "autoupdate": true,
  "share": "manual",
  "permission": {
    "write": "ask",
    "bash": "ask",
    "edit": "ask"
  },
  "tools": {
    "read": true,
    "write": true,
    "edit": true,
    "bash": true,
    "glob": true,
    "grep": true,
    "list": true,
    "webfetch": true,
    "travel-geocoder*": false,
    "travel-flight*": false,
    "travel-hotel*": false,
    "travel-event*": false,
    "travel-weather*": false,
    "travel-finance*": false
  },
  "instructions": ["CONTRIBUTING.md", "README.md", "*.md"],
  "formatter": {
    "terraform": {
      "command": ["terraform", "fmt", "-"],
      "extensions": [".tf", ".tfvars"]
    },
    "prettier": {
      "command": ["npx", "prettier", "--write", "$FILE"],
      "extensions": [".yaml", ".yml", ".json", ".md"]
    },
    "python": {
      "command": ["black", "-"],
      "extensions": [".py"]
    }
  },
  "disabled_providers": [],
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "environment": {
        "DEFAULT_MINIMUM_TOKENS": ""
      }
    },
    "ddg-search": {
      "type": "local",
      "command": ["uvx", "duckduckgo-mcp-server"],
      "enabled": false
    },
    "google-search": {
      "type": "local",
      "command": ["npx", "-y", "@adenot/mcp-google-search"],
      "environment": {
        "GOOGLE_SEARCH_ENGINE_ID": "{env:GOOGLE_SEARCH_ENGINE_ID}",
        "GOOGLE_API_KEY": "{env:GOOGLE_API_KEY}"
      },
      "enabled": true
    },
    "paperless": {
      "type": "local",
      "command": [
        "npx",
        "@nloui/paperless-mcp",
        "https://paperless.aitbytes.fyi",
        "4741262da2bfc9b7a7915bc0fe4966794cb7ec37"
      ],
      "enabled": false
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/sse",
      "enabled": false
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_TOOLSETS": "",
        "GITHUB_READ_ONLY": "",
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "enabled": false
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "web-search": {
      "type": "remote",
      "url": "http://localhost:3002/mcp",
      "enabled": false
    },
    "travel-geocoder": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "/home/a8taleb/Documents/Travel/mcp_travelassistant/servers/geocoder_server",
        "run",
        "python",
        "geocoder_server.py"
      ],
      "enabled": false
    },
    "travel-flight": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "/home/a8taleb/Documents/Travel/mcp_travelassistant/servers/flight_server",
        "run",
        "python",
        "flight_server.py"
      ],
      "environment": {
        "SERPAPI_KEY": "{env:SERPAPI_KEY}"
      },
      "enabled": false
    },
    "travel-hotel": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "/home/a8taleb/Documents/Travel/mcp_travelassistant/servers/hotel_server",
        "run",
        "python",
        "hotel_server.py"
      ],
      "environment": {
        "SERPAPI_KEY": "{env:SERPAPI_KEY}"
      },
      "enabled": false
    },
    "travel-event": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "/home/a8taleb/Documents/Travel/mcp_travelassistant/servers/event_server",
        "run",
        "python",
        "event_server.py"
      ],
      "environment": {
        "SERPAPI_KEY": "{env:SERPAPI_KEY}"
      },
      "enabled": false
    },
    "travel-weather": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "/home/a8taleb/Documents/Travel/mcp_travelassistant/servers/weather_server",
        "run",
        "python",
        "weather_server.py"
      ],
      "enabled": false
    },
    "travel-finance": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "/home/a8taleb/Documents/Travel/mcp_travelassistant/servers/finance_server",
        "run",
        "python",
        "finance_search_server.py"
      ],
      "environment": {
        "SERPAPI_KEY": "{env:SERPAPI_KEY}"
      },
      "enabled": false
    },
    "arxiv": {
      "type": "local",
      "command": [
        "uv",
        "tool",
        "run",
        "arxiv-mcp-server",
        "--storage-path",
        "/tmp/arxiv-papers"
      ],
      "enabled": false
    },
    "youtube-transcript": {
      "type": "local",
      "command": ["npx", "-y", "@kimtaeyoon83/mcp-server-youtube-transcript"],
      "enabled": false
    },
    "pymupdf4llm": {
      "type": "local",
      "command": ["uvx", "pymupdf4llm-mcp@latest", "stdio"],
      "enabled": false
    },
    "wikidata": {
      "type": "remote",
      "url": "https://wd-mcp.wmcloud.org/mcp/",
      "enabled": false
    }
  }
}
